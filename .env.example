# Firebase Config Example
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Groq AI Cloud API Key for Medscope AI Engines
VITE_GROQ_API_KEY=your_groq_api_key_here

# OCR.space API Key for Medical Lab Report OCR Scanning
VITE_OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Google Gemini AI API Key for Clinical Report Reasoning & Summarization
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Security
VITE_SECURE_STORAGE_KEY=your_secure_storage_32_char_secret

